// FitSync AI Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ExerciseCategory {
  Strength
  Cardio
  Flexibility
  Mobility
}

enum MuscleGroup {
  Chest
  Back
  Legs
  Shoulders
  Arms
  Core
  FullBody
}

enum Equipment {
  Barbell
  Dumbbell
  Machine
  Bodyweight
  Cable
  Other
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

enum WorkoutStatus {
  Planned
  InProgress
  Completed
}

enum Visibility {
  Private
  Public
}

enum GoalType {
  WEIGHT
  STRENGTH
  CONSISTENCY
  CUSTOM
}

enum GoalUnit {
  kg
  lbs
  reps
  workouts
  percent
}

